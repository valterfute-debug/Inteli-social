# Somente valores de exemplo. Configure as URLs reais apenas no .env local.
NODE_ENV=development
PORT=3000
# Backend persistente em IPv4: Connect > Session pooler (5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@POOLER_HOST:5432/postgres?sslmode=require"
# CLI: conexão direta quando acessível; Session pooler (5432) como alternativa IPv4.
# Não use Transaction pooler (6543) para migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@POOLER_HOST:5432/postgres?sslmode=require"
# Supabase: Project Settings > API. A URL também é usada para validar o login (obrigatória para a API funcionar).
# A service_role/secret key NUNCA vai para o frontend.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="CHAVE_SERVICE_ROLE"
SUPABASE_STORAGE_BUCKET="fotos-animais"
# Validade dos links de leitura das fotos, em segundos (60 a 3600; padrão 900 = 15 min).
FOTO_URL_VALIDADE_SEGUNDOS=900
# Só para `npm run token` (gerar token de teste pelo terminal). Chave pública, não é segredo.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Hardening (Sprint 3). Origens do frontend separadas por vírgula; vazio = qualquer origem
# fora de produção e nenhuma em produção.
CORS_ORIGINS="http://localhost:5173"
# Swagger (/docs) fica desligado em produção, salvo SWAGGER_ENABLED=true.
SWAGGER_ENABLED=false
LIMITE_REQUISICOES_POR_MINUTO=600
# Limpeza de fotos órfãs e chaves antigas a cada N horas (0 desliga; npm run manutencao roda na hora).
MANUTENCAO_INTERVALO_HORAS=6
