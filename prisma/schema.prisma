generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Front {
  CCPA
  CASADOTE
  CED
}
enum Sexo {
  MACHO
  FEMEA
}
enum Porte {
  PEQUENO
  MEDIO
  GRANDE
}
enum TipoEventoSaude {
  VACINA
  VERMIFUGO
  CASTRACAO
}
enum SituacaoFoto {
  PENDENTE
  CONFIRMADA
}
// Papéis provisórios até a Ampara aprovar os perfis (issue #3, P0-2).
enum PapelUsuario {
  ADMIN
  OPERADOR
}
model Species {
  id String @id @default(uuid())
  name String @unique
  silvestre Boolean @default(false)
  breeds Breed[]
  animals Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}
model Breed {
  id String @id @default(uuid())
  name String
  speciesId String
  species Species @relation(fields: [speciesId], references: [id])
  animals Animal[]
  @@unique([speciesId, name])
  @@unique([id, speciesId])
}
model Unit {
  id String @id @default(uuid())
  name String @unique
  endereco String?
  horariosFuncionamento String?
  locations Location[]
  animals Animal[]
  usuarios UsuarioUnidade[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}
model Location {
  id String @id @default(uuid())
  name String
  unitId String
  unit Unit @relation(fields: [unitId], references: [id])
  animals Animal[]
  @@unique([unitId, name])
  @@unique([id, unitId])
}
model Responsible {
  id String @id @default(uuid())
  name String
  endereco String?
  email String?
  telefone String?
  active Boolean @default(true)
  animals Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}
model Animal {
  id String @id
  name String?
  publicId String @unique
  microchip String?
  dataEntrada DateTime?
  sexo Sexo?
  idadeAproximadaMeses Int?
  pesoKg Decimal? @db.Decimal(6, 2)
  porte Porte?
  cor String?
  observacoes String?
  fotoEntradaId String? @unique
  fotoEntrada Foto? @relation(fields: [fotoEntradaId], references: [id])
  speciesId String
  species Species @relation(fields: [speciesId], references: [id])
  breedId String?
  breed Breed? @relation(fields: [breedId, speciesId], references: [id, speciesId])
  unitId String
  unit Unit @relation(fields: [unitId], references: [id])
  locationId String
  location Location @relation(fields: [locationId, unitId], references: [id, unitId])
  responsibleId String
  responsible Responsible @relation(fields: [responsibleId], references: [id])
  front Front
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  healthEvents HealthEvent[]
  @@index([name])
  @@index([speciesId])
  @@index([microchip])
}
model Foto {
  id String @id @default(uuid())
  tipoMidia String
  tamanhoBytes Int
  caminhoArmazenamento String
  situacao SituacaoFoto @default(PENDENTE)
  expiraEm DateTime
  criadoPorId String?
  criadoPor Usuario? @relation(fields: [criadoPorId], references: [id])
  animal Animal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// Conta liberada na API. `id` é o `sub` do token do Supabase Auth: logar no Supabase
// não basta, a conta precisa existir aqui e estar ativa.
model Usuario {
  id String @id
  email String?
  nome String?
  papel PapelUsuario @default(OPERADOR)
  ativo Boolean @default(true)
  unidades UsuarioUnidade[]
  fotos Foto[]
  chavesIdempotencia ChaveIdempotencia[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// Idempotency-Key já processada (issue #3, P0-3). Gravada na mesma transação da escrita:
// se existe, a operação aconteceu. Chave única por usuário; retenção de 30 dias.
model ChaveIdempotencia {
  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  chave String
  operacao String
  hashConteudo String
  recursoId String
  createdAt DateTime @default(now())
  @@id([usuarioId, chave])
  @@index([createdAt])
}
model UsuarioUnidade {
  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unitId String
  unit Unit @relation(fields: [unitId], references: [id])
  createdAt DateTime @default(now())
  @@id([usuarioId, unitId])
  @@index([unitId])
}
model HealthEvent {
  id String @id @default(uuid())
  animalId String
  animal Animal @relation(fields: [animalId], references: [id])
  tipo TipoEventoSaude
  descricao String?
  data DateTime
  observacoes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  @@index([animalId])
  @@index([animalId, tipo])
}
