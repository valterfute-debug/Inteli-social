generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Front {
  CCPA
  CASADOTE
  CED
}
enum Sexo {
  MACHO
  FEMEA
}
enum Porte {
  PEQUENO
  MEDIO
  GRANDE
}
enum TipoEventoSaude {
  VACINA
  VERMIFUGO
  CASTRACAO
}
model Species {
  id String @id @default(uuid())
  name String @unique
  breeds Breed[]
  animals Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}
model Breed {
  id String @id @default(uuid())
  name String
  speciesId String
  species Species @relation(fields: [speciesId], references: [id])
  animals Animal[]
  @@unique([speciesId, name])
  @@unique([id, speciesId])
}
model Unit {
  id String @id @default(uuid())
  name String @unique
  endereco String?
  horariosFuncionamento String?
  locations Location[]
  animals Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}
model Location {
  id String @id @default(uuid())
  name String
  unitId String
  unit Unit @relation(fields: [unitId], references: [id])
  animals Animal[]
  @@unique([unitId, name])
  @@unique([id, unitId])
}
model Responsible {
  id String @id @default(uuid())
  name String
  endereco String?
  email String?
  telefone String?
  active Boolean @default(true)
  animals Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}
model Animal {
  id String @id
  name String?
  publicId String @unique
  microchip String?
  dataEntrada DateTime?
  sexo Sexo?
  idadeAproximadaMeses Int?
  pesoKg Decimal? @db.Decimal(6, 2)
  porte Porte?
  cor String?
  speciesId String
  species Species @relation(fields: [speciesId], references: [id])
  breedId String?
  breed Breed? @relation(fields: [breedId, speciesId], references: [id, speciesId])
  unitId String
  unit Unit @relation(fields: [unitId], references: [id])
  locationId String
  location Location @relation(fields: [locationId, unitId], references: [id, unitId])
  responsibleId String
  responsible Responsible @relation(fields: [responsibleId], references: [id])
  front Front
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  healthEvents HealthEvent[]
  @@index([name])
  @@index([speciesId])
}
model HealthEvent {
  id String @id @default(uuid())
  animalId String
  animal Animal @relation(fields: [animalId], references: [id])
  tipo TipoEventoSaude
  descricao String?
  data DateTime
  observacoes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  @@index([animalId])
  @@index([animalId, tipo])
}
