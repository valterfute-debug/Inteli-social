# Somente valores de exemplo. Configure as URLs reais apenas no .env local.
NODE_ENV=development
PORT=3000
# Backend persistente em IPv4: Connect > Session pooler (5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@POOLER_HOST:5432/postgres?sslmode=require"
# CLI: conexão direta quando acessível; Session pooler (5432) como alternativa IPv4.
# Não use Transaction pooler (6543) para migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@POOLER_HOST:5432/postgres?sslmode=require"
